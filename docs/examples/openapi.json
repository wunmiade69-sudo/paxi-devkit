{
  "openapi": "3.0.3",
  "info": {
    "title": "PAXI Example API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8080/api" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service health response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string" }
        },
        "required": ["status"]
      }
    }
  }
}
